          {
            "id": "pid_credential",
            "format": "dc+sd-jwt",
            "meta": { "vct_values": [ "urn:eudi:pid:de:1" ] },
            "claims": [
              { "path": [ "given_name" ] }
            ]
          }
        ],
        "credential_sets": [
          {
            "purpose": "Identification",
            "options": [
              [ "pid_credential" ]
            ]
          }
        ]
      }
    },
    "pid_nbf": {
