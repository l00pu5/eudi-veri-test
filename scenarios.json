    "full_pid_with_claim_sets": {
      "name": "DE National PID - PID-Check mit claim_sets + aki",
      "description": "Fordert Vorname, Nachname und die Bestätigung 'age_equal_or_over 18' aus der deutschen PID an.",
      "certs": {
        "accessCertificate": "certs/access_certificate_02.cer",
        "accessPrivateKey": "certs/access_certificate_key_02.pem",
        "registrationCertificate": "certs/registration_certificate_02.jwt"
      },
      "dcqlQuery": { 
        "credentials": [ 
          { 
            "id": "de_pid_credential", 
            "format": "dc+sd-jwt", 
            "meta": { "vct_values": [ "urn:eudi:pid:de:1" ] }, 
            "trusted_authorities": [
              {
                "type": "aki",
                "values": [
                  "DwxXXjAPjh_JTDmMvShj9mxzzd4",
                  "meBmzkS6HU7Aiwkm88YrTJ-AjAQ",
                  "gF_OyGFlHJhs9NWUXV_6gFhDvl8"
                ]
              }
            ],
            "claims": [ 
              { "id": "c_given_name", "path": ["given_name"] }, 
              { "id": "c_family_name", "path": ["family_name"] }, 
              { "id": "c_birthdate", "path": ["birthdate"] }, 
              { "id": "c_birth_name", "path": ["birth_name"] }, 
              { "id": "c_title", "path": ["title"] }, 
              { "id": "c_place_of_birth", "path": ["place_of_birth", "locality"] }, 
              { "id": "c_street_address", "path": ["address", "street_address"] }, 
              { "id": "c_locality", "path": ["address", "locality"] }, 
              { "id": "c_postal_code", "path": ["address", "postal_code"] }, 
              { "id": "c_country", "path": ["address", "country"] } 
            ], 
            "claim_sets": [ 
              [ "c_title", "c_birthdate", "c_place_of_birth", "c_given_name", "c_locality", "c_country", "c_family_name", "c_postal_code", "c_street_address", "c_birth_name" ], 
              [ "c_birthdate", "c_place_of_birth", "c_given_name", "c_locality", "c_country", "c_family_name", "c_postal_code", "c_street_address", "c_birth_name" ] 
            ]   
          } 
        ] 
      }
    },
    "pid_mdoc_age_18": {
      "name": "EUDI PID (ISO mdoc) - Altersnachweis (18+)",
      "description": "Fordert Vorname, Nachname und die Bestätigung 'age_over_18' aus der PID im ISO mdoc-Format an.",
      "certs": {
        "accessCertificate": "certs/access_certificate_mdoc.cer",
        "accessPrivateKey": "certs/access_certificate_key_mdoc.pem",
        "registrationCertificate": "certs/registration_certificate_mdoc.jwt"
      },
      "dcqlQuery": {
        "credentials": [
          {
            "id": "pid_mdoc_credential",
            "format": "mso_mdoc",
            "meta": { "doctype_value": "eu.europa.ec.eudi.pid.1" },
            "claims": [
              { "path": [ "eu.europa.ec.eudi.pid.1", "family_name" ] },
              { "path": [ "eu.europa.ec.eudi.pid.1", "given_name" ] },
              { "path": [ "eu.europa.ec.eudi.pid.de.1", "age_over_18" ] }
            ]
          }
        ]
      }
    },
    "pid_full_identity": {
      "name": "DE National PID - Vollständige Identität",
