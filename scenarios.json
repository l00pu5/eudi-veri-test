              { "id": "claim_height", "path": ["org.iso.18013.5.1", "height"] }, 
              { "id": "claim_weight", "path": ["org.iso.18013.5.1", "weight"] }, 
              { "id": "claim_eye_colour", "path": ["org.iso.18013.5.1", "eye_colour"] }, 
              { "id": "claim_hair_colour", "path": ["org.iso.18013.5.1", "hair_colour"] }, 
              { "id": "claim_place_of_birth", "path": ["org.iso.18013.5.1", "place_of_birth"] }, 
              { "id": "claim_resident_address", "path": ["org.iso.18013.5.1", "resident_address"] }, 
              { "id": "claim_resident_city", "path": ["org.iso.18013.5.1", "resident_city"] }, 
              { "id": "claim_resident_postal_code", "path": ["org.iso.18013.5.1", "resident_postal_code"] }, 
              { "id": "claim_resident_country", "path": ["org.iso.18013.5.1", "resident_country"] }, 
